# Copia este archivo a .env antes de arrancar: cp .env.example .env
# En Docker las vars se inyectan desde aquí vía env_file en compose.

# ── Base de datos ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appdb

# ── Backend ────────────────────────────────────────────────────
PORT=8080
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ── Auth ───────────────────────────────────────────────────────
# Comma-separated list of emails that receive the super_admin role on registration.
SUPER_ADMIN_EMAILS=admin@example.com
SESSION_DURATION_HOURS=24

# ── Frontend ───────────────────────────────────────────────────
PUBLIC_API_URL=http://localhost:8080
# Private URL used by SvelteKit server-side hooks to reach the backend.
API_URL=http://localhost:8080
